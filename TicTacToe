import random
import time
import logging
from seleniumbase import Driver
import requests

# Setup logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

def omnistical_delay(min_t=3.0, max_t=7.0):
    """Randomized delay to mimic human behavior."""
    delay = random.uniform(min_t, max_t)
    logging.info(f"Delaying for {delay:.1f} seconds...")
    time.sleep(delay)

def upload_sequence(video_path, description):
    driver = None
    try:
        logging.info("🌀 Awakening Kalki session...")
        # UC mode + persistent profile for better stealth and session reuse
        driver = Driver(uc=True, user_data_dir="./kalki_session", browser="chrome")
        driver.set_window_size(1920, 1080)

        driver.uc_open_with_reconnect("https://www.tiktok.com/upload", reconnect_time=8)
        omnistical_delay(7, 12)

        # Handle possible login redirect
        if "login" in driver.current_url.lower():
            logging.warning("Login required. Please log in manually in the opened browser window.")
            driver.wait_for_element_present('input[type="file"]', timeout=180)  # Longer wait for manual login

        # File upload
        driver.wait_for_element_present('input[type="file"]', timeout=30)
        driver.choose_file('input[type="file"]', video_path)
        logging.info("Video payload delivered. Waiting for processing...")

        # Wait for description box (indicates video is ready for editing)
        driver.wait_for_element_visible('div[role="textbox"]', timeout=90)
        omnistical_delay(8, 15)

        # Description (with some randomization for less pattern detection)
        full_desc = f"{description} #Kalki #DiMiThai #ML #Omnism #ThaiMusic2026 #Jaytdnd"
        if random.random() > 0.7:
            full_desc += " 🔥"

        textbox_selector = 'div[role="textbox"]'
        driver.uc_click(textbox_selector)

        # Human-like typing
        for char in full_desc:
            driver.send_keys(textbox_selector, char)
            time.sleep(random.uniform(0.05, 0.15))

        omnistical_delay(5, 10)

        # Scroll to bottom (sometimes helps with button visibility)
        driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
        omnistical_delay(2, 4)

        # Post button — critical improvement: wait for enabled state
        post_btn_xpath = '//button[@data-e2e="post_video_button" and @aria-disabled="false"]'
        driver.wait_for_element_clickable(post_btn_xpath, timeout=60)
        driver.uc_click(post_btn_xpath)

        logging.info(f"🔥 Deployment Successful: {description}")

        # Post-upload human behavior
        omnistical_delay(10, 15)
        driver.get("https://www.tiktok.com/foryou")
        time.sleep(random.randint(30, 90))

    except Exception as e:
        logging.error(f"❌ System failure in Kalki sequence: {e}")
        if driver:
            try:
                driver.save_screenshot("upload_error.png")
                logging.info("Screenshot saved to upload_error.png")
            except:
                pass
    finally:
        if driver:
            driver.quit()


def get_etherscan_balance(api_key, wallet_address, chain_id=1):
    """
    Fetches native token balance using Etherscan V2 API (multi-chain support).
    """
    url = "https://api.etherscan.io/v2/api"
    params = {
        "chainid": chain_id,
        "module": "account",
        "action": "balance",
        "address": wallet_address,
        "tag": "latest",
        "apikey": api_key or ""  # API key optional for low rate limits
    }

    try:
        response = requests.get(url, params=params, timeout=15)
        response.raise_for_status()
        data = response.json()

        if data.get('status') == '1':
            balance_wei = int(data['result'])
            balance_eth = balance_wei / 10**18
            return f"✅ Balance on chain {chain_id}: {balance_eth:.6f} ETH"
        else:
            return f"❌ API Error: {data.get('message')} - {data.get('result', '')}"
    except requests.exceptions.RequestException as e:
        return f"❌ Connection Error: {e}"
    except (KeyError, ValueError, TypeError) as e:
        return f"❌ Parsing Error: {e}"


def run_eternal_scheduler():
    video_path = "./video.mp4"  # Update this if needed
    api_key = "YOUR_ETHERSCAN_API_KEY"  # Replace with real key (or leave empty for demo)
    wallet = "0xde0B295669a9FD93d5F28D9Ec85E40f4cb697BAe"  # Example

    while True:
        current_time = time.strftime("%H:%M")
        logging.info(f"[{current_time}] Kalki Cycle Initiated.")

        # Optional: check balance before upload (demo)
        balance_info = get_etherscan_balance(api_key, wallet)
        logging.info(balance_info)

        # Upload with dynamic description
        desc = f"Kalki frequency shift at {current_time}"
        upload_sequence(video_path, desc)

        # Randomized sleep ~45-75 minutes (avoids exact hourly pattern)
        sleep_time = random.randint(2700, 4500)
        logging.info(f"Dormant for {sleep_time // 60} minutes until next shift...")
        time.sleep(sleep_time)


if __name__ == "__main__":
    run_eternal_scheduler()
