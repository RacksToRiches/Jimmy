CREATE VIEW iowa_compliance_audit AS
SELECT 
    id, product_name,
    ((thca_pct * 0.877) + d9_pct) AS total_thc_calculated,
    CASE 
        WHEN is_inhalable = 1 THEN 'BANNED_INHALABLE'
        WHEN ((thca_pct * 0.877) + d9_pct) > 0.3 THEN 'EXCEEDS_CONCENTRATION'
        WHEN (weight_g * 10 * ((thca_pct * 0.877) + d9_pct)) > 10 THEN 'EXCEEDS_DOSAGE'
        ELSE 'LEGAL'
    END AS compliance_label
FROM hemp_inventory;

import pandas as pd

# 2026 Iowa Statutory Constants (HF 2605)
IA_CONFIG = {
    "max_total_thc_pct": 0.3,
    "max_mg_per_serving": 4.0,
    "max_mg_per_container": 10.0,
    "allow_inhalables": False,
    "conversion_factor": 0.877
}

def analyze_compliance(product_data):
    """
    Analyzes a product against IA 2026 standards.
    Input: Dict with 'thca', 'd9', 'weight', 'servings', 'is_inhalable'
    """
    # 1. Formulaic conversion
    total_thc_pct = (product_data['thca'] * IA_CONFIG['conversion_factor']) + product_data['d9']
    total_mg_container = (product_data['weight'] * 10) * total_thc_pct
    mg_per_serving = total_mg_container / product_data['servings']
    
    # 2. Risk Assessment Logic
    violations = []
    if product_data['is_inhalable'] and not IA_CONFIG['allow_inhalables']:
        violations.append("CRIMINAL_VIO: Inhalable hemp is a Serious Misdemeanor (IA Code 204.14A)")
    
    if total_thc_pct > IA_CONFIG['max_total_thc_pct']:
        violations.append(f"CONC_VIO: {total_thc_pct:.3f}% exceeds 0.3% limit")
        
    if total_mg_container > IA_CONFIG['max_mg_per_container']:
        violations.append(f"DOSAGE_VIO: {total_mg_container:.2f}mg exceeds 10mg container limit")

    return {
        "status": "NON-COMPLIANT" if violations else "COMPLIANT",
        "total_thc_mg": round(total_mg_container, 2),
        "violations": violations
    }

