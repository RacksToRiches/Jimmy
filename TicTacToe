def get_etherscan_balance(api_key: str, wallet_address: str, chain_id: int = 1) -> float | None:
    """Fetch native ETH balance using Etherscan V2 API."""
    url = "https://api.etherscan.io/v2/api"
    params = {
        "chainid": chain_id,
        "module": "account",
        "action": "balance",
        "address": wallet_address,
        "tag": "latest",
        "apikey": api_key
    }
    
    try:
        response = requests.get(url, params=params, timeout=15)
        response.raise_for_status()
        data = response.json()
        
        if data.get('status') == '1':
            return float(data['result']) / 1e18
        else:
            print(f"⚠️ Etherscan API Error: {data.get('message', 'Unknown error')}")
            return None
    except Exception as e:
        print(f"⚠️ Balance Check Failed: {e}")
        return None


def upload_to_tiktok(video_path: str, description: str):
    """Automated TikTok video upload using SeleniumBase."""
    driver = None
    try:
        print("🌐 Launching browser with existing TikTok session...")
        driver = Driver(uc=True, user_data_dir=TIKTOK_SESSION_DIR)
        
        driver.uc_open_with_reconnect("https://www.tiktok.com/upload", reconnect_time=8)
        
        # Handle login if needed
        if "login" in driver.current_url.lower():
            print("🔑 Login page detected. Please log in manually in the browser window...")
            driver.wait_for_element_present('input[type="file"]', timeout=180)
        
        print("📤 Uploading video...")
        driver.choose_file('input[type="file"]', video_path)
        
        driver.wait_for_element_visible('div[role="textbox"]', timeout=60)
        
        full_desc = f"{description} {HASHTAGS}"
        driver.send_keys('div[role="textbox"]', full_desc)
        
        # Optional: small delay before posting
        time.sleep(5)
        
        print("🚀 Clicking Post button...")
        driver.click('button[data-e2e="post_video_button"]')
        
        print(f"✅ Successfully triggered upload: {description}")
        
    except Exception as e:
        print(f"❌ Upload Error: {e}")
    finally:
        if driver:
            driver.quit()


def send_refund(transaction_id: str, amount: float, currency: str = "USD"):
    """Send refund via payment API (placeholder - update endpoint as needed)."""
    payload = {
        "transaction_id": transaction_id,
        "amount": int(round(amount * 100)),  # convert to cents
        "currency": currency,
        "reason": "customer_request"
    }
    
    headers = {
        "Authorization": f"Bearer {PAYMENT_API_KEY}",
        "Content-Type": "application/json"
    }
    
    try:
        resp = requests.post(REFUND_ENDPOINT, json=payload, headers=headers, timeout=10)
        resp.raise_for_status()
        print("✅ Refund request sent successfully")
        return resp.json()
    except requests.exceptions.RequestException as e:
        print(f"❌ Refund Error: {e}")
        if hasattr(e, 'response') and e.response is not None:
            print(f"Response: {e.response.text}")
        return None


