def omnistical_delay(min_t=3.0, max_t=7.0):
    """Randomized human-like delay."""
    time.sleep(random.uniform(min_t, max_t))

def upload_sequence(video_path, description):
    print("🌀 Starting Kalki TikTok Upload Sequence...")
    
    driver = Driver(
        uc=True,                    # Undetected Chrome mode (best for 2026 anti-detection)
        user_data_dir=TIKTOK_SESSION_DIR,
        browser="chrome"
    )
    driver.set_window_size(1920, 1080)
    
    try:
        driver.uc_open_with_reconnect("https://www.tiktok.com/upload", reconnect_time=8)
        omnistical_delay(8, 14)

        # Manual login fallback if needed
        if "login" in driver.current_url.lower():
            print("⚠️  Login required. Please log in manually in the opened browser window.")
            driver.wait_for_element_present('input[type="file"]', timeout=180)

        # File upload
        driver.wait_for_element_present('input[type="file"]', timeout=45)
        driver.choose_file('input[type="file"]', video_path)
        print("✅ Video file injected. Processing...")
        
        # Wait for description box
        driver.wait_for_element_visible('div[role="textbox"]', timeout=90)
        omnistical_delay(12, 18)

        # Fill description with human typing simulation
        full_desc = f"{description} {HASHTAGS}"
        textbox = 'div[role="textbox"]'
        
        driver.uc_click(textbox)
        for char in full_desc:
            driver.send_keys(textbox, char)
            time.sleep(random.uniform(0.05, 0.13))  # Natural typing speed

        omnistical_delay(5, 10)

        # Scroll and post
        driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
        post_btn = 'button[data-e2e="post_video_button"]'
        
        driver.wait_for_element_clickable(post_btn, timeout=30)
        driver.uc_click(post_btn)
        
        print(f"🚀 Upload Successful: {description}")
        
        # Post-upload human behavior
        omnistical_delay(12, 20)
        driver.get("https://www.tiktok.com/foryou")
        time.sleep(random.randint(40, 90))
        
    except Exception as e:
        print(f"❌ Upload failed: {e}")
    finally:
        driver.quit()

def get_etherscan_balance(api_key, wallet_address, chain_id=1):
    """Fetch native balance using Etherscan V2 API (2026)."""
    url = "https://api.etherscan.io/v2/api"
    
    params = {
        "chainid": chain_id,
        "module": "account",
        "action": "balance",
        "address": wallet_address,
        "tag": "latest",
        "apikey": api_key
    }
    
    try:
        response = requests.get(url, params=params, timeout=15)
        data = response.json()
        
        if data.get('status') == '1':
            balance_wei = int(data['result'])
            balance_eth = balance_wei / 1e18
            return f"✅ Balance on chain {chain_id}: {balance_eth:.6f} ETH"
        else:
            return f"❌ API Error: {data.get('message')} | Result: {data.get('result')}"
            
    except Exception as e:
        return f"❌ Connection Error: {e}"

def run_eternal_scheduler():
    print("🌌 Eternal Kalki Scheduler Started...")
    while True:
        current_time = time.strftime("%Y-%m-%d %H:%M:%S")
        print(f"[{current_time}] Initiating next cycle...")
        
        description = f"Kalki frequency shift • {time.strftime('%H:%M')} UTC"
        upload_sequence(VIDEO_PATH, description)
        
        # Random sleep between ~45min to ~75min (breaks predictable pattern)
        sleep_time = random.randint(2700, 4500)
        print(f"💤 Dormant for {sleep_time // 60} minutes...")
        time.sleep(sleep_time)

