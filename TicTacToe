    root.mainloop()

# HTTP API
app = FastAPI(title="Random Number Bot API")

class SingleRequest(BaseModel):
    min: int = 1
    max: int = 100

class MultipleRequest(BaseModel):
    count: int
    min: int = 1
    max: int = 100
    unique: bool = False

class RangeRequest(BaseModel):
    min: int
    max: int
    step: int = 1

@app.post("/single")
def api_single(req: SingleRequest):
    val = single_random(req.min, req.max)
    log_result({"mode": "single_api", "min": req.min, "max": req.max, "result": val})
    return {"result": val}

@app.post("/multiple")
def api_multiple(req: MultipleRequest):
    nums = multiple_random(req.count, req.min, req.max, unique=req.unique)
    log_result({"mode": "multiple_api", "count": req.count, "min": req.min, "max": req.max, "unique": req.unique, "result": nums})
    return {"result": nums}

@app.post("/range")
def api_range(req: RangeRequest):
    seq = ranged_sequence(req.min, req.max, req.step)
    log_result({"mode": "range_api", "min": req.min, "max": req.max, "step": req.step, "result": seq})
    return {"result": seq}

def start_api():
    uvicorn.run(app, host="127.0.0.1", port=8000, log_level="info")

# Entrypoint
def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--no-console", action="store_true", help="Don't start console interface")
    parser.add_argument("--start-gui", action="store_true", help="Start GUI immediately")
    parser.add_argument("--start-api", action="store_true", help="Start API server immediately")
    args = parser.parse_args()

    if args.start_api:
        threading.Thread(target=start_api, daemon=True).start()
    if args.start_gui:
        threading.Thread(target=start_gui, daemon=True).start()
    if not args.no_console:
        console_interface()
    else:
        print("Running headless. GUI/API threads may be running; press Ctrl+C to exit.")
        try:
            while True:
                threading.Event().wait(3600)
        except KeyboardInterrupt:
            print("Exiting.")

if __name__ == "__main__":
    main()

                