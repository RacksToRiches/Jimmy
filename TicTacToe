CREATE VIEW iowa_compliance_engine AS
SELECT 
    product_name,
    weight_g,
    -- Calculate Iowa's Total THC value
    ((thca_pct * 0.877) + d9_pct) AS total_thc_pct,
    -- Calculate total milligrams in the entire package
    (weight_g * 10 * ((thca_pct * 0.877) + d9_pct)) AS package_mg_total,
    CASE 
        WHEN is_inhalable = TRUE THEN 'ILLEGAL: Banned Inhalable Form'
        WHEN ((thca_pct * 0.877) + d9_pct) > 0.3 THEN 'ILLEGAL: Concentration High'
        WHEN (weight_g * 10 * ((thca_pct * 0.877) + d9_pct)) > 10 THEN 'ILLEGAL: Dosage High'
        ELSE 'COMPLIANT'
    END AS compliance_status
FROM inventory_table;
