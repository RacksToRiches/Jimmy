import pandas as pd

def check_iowa_status(weight_g, thca_pct, d9_pct, is_inhalable):
    """
    Evaluates Iowa compliance for 2026.
    """
    # 1. Calculation
    total_thc_pct = (thca_pct * 0.877) + d9_pct
    total_thc_mg = weight_g * 1000 * (total_thc_pct / 100)

    # 2. Logic Gates
    if is_inhalable:
        return "🛑 ILLEGAL: All inhalables (flower/vapes) are banned in Iowa (Code 204.14A)."
    
    if total_thc_pct > 0.3:
        return f"🛑 ILLEGAL: {total_thc_pct:.2f}% Total THC exceeds the 0.3% cap."
    
    if total_thc_mg > 10:
        return f"🛑 ILLEGAL: {total_thc_mg:.1f}mg THC exceeds the 10mg/package limit."

    return f"✅ COMPLIANT: {total_thc_mg:.1f}mg total THC is within limits."

# Test: The 6-gram Flower Scenario
