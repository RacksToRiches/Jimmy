import random
import time
from seleniumbase import Driver

def omnistical_delay(min_t=3.0, max_t=7.0):
    """Slightly longer, randomized delays to mimic human hesitation."""
    time.sleep(random.uniform(min_t, max_t))

def upload_sequence(video_path, description):
    # FIX 1: Use 'incognito=True' to prevent session leak and 'multi_proxy' if scaling
    # Replaced 'agent' with a more recent 2026-standard UA
    driver = Driver(uc=True, incognito=True)
    
    try:
        # FIX 2: UC Reconnect with longer buffer for TikTok's 2026 scripts
        driver.uc_open_with_reconnect("https://www.tiktok.com/upload", reconnect_time=6)
        omnistical_delay(5, 8)

        # FIX 3: TikTok often uses a drop-zone or hidden input. 
        # Using wait_for_element_present before injection ensures the DOM is ready.
        driver.wait_for_element_present('input[type="file"]', timeout=20)
        driver.choose_file('input[type="file"]', video_path)
        print("Video file injected. Processing...")
        
        # Processing wait depends on file size; 20s is safer for 2026 HD uploads
        omnistical_delay(15, 25) 

        # FIX 4: Use 'uc_click' followed by 'send_keys' with a slow delay
        full_desc = f"{description} #DiMiThai #ML #Omnism #ThaiMusic2026 #Jaytdnd"
        textbox_selector = 'div[role="textbox"]'
        
        driver.uc_click(textbox_selector)
        # Slow typing to mimic human speed (0.05s to 0.15s per char)
        for char in full_desc:
            driver.send_keys(textbox_selector, char)
            time.sleep(random.uniform(0.05, 0.15))
        
        omnistical_delay(4, 6)
        
        # FIX 5: Scroll to the button first (avoids "element not interactable" errors)
        driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
        driver.uc_click('button:contains("Post")')
        
        print(f"Post successful for: {description}")
        omnistical_delay(5, 10) # Wait to ensure the post request finishes
        
    except Exception as e:
        print(f"Error encountered: {e}")
    finally:
        driver.quit()

def run_eternal_scheduler():
    while True:
        current_hour = time.strftime("%H:%M")
        print(f"[{current_hour}] Cycle Start.")
        # Ensure 'video.mp4' is the absolute path for reliability
        upload_sequence("./video.mp4", f"Elevating frequency: {current_hour}")
        
        # Jittered hour sleep
        sleep_time = 3600 + random.randint(-180, 600)
        print(f"Next cycle in {sleep_time // 60} minutes...")
        time.sleep(sleep_time)

if __name__ == "__main__":
    run_eternal_scheduler()


        

