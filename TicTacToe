# random_bot_full.py
import random
import threading
import argparse
import json
from datetime import datetime
from pathlib import Path

# Optional GUI
import tkinter as tk
from tkinter import scrolledtext, simpledialog, messagebox

# FastAPI
from fastapi import FastAPI
from pydantic import BaseModel
import uvicorn

LOG_PATH = Path("random_bot_log.jsonl")

# Core RNG functions
def single_random(min_val=1, max_val=100):
    return random.randint(min_val, max_val)

def multiple_random(count, min_val=1, max_val=100, unique=False):
    if unique:
        if count > (max_val - min_val + 1):
            raise ValueError("Count larger than unique values available in range.")
        return random.sample(range(min_val, max_val+1), count)
    return [random.randint(min_val, max_val) for _ in range(count)]

def ranged_sequence(min_val, max_val, step=1):
    if step == 0:
        raise ValueError("Step cannot be 0.")
    if (min_val < max_val and step < 0) or (min_val > max_val and step > 0):
        raise ValueError("Step sign inconsistent with min/max.")
    end = max_val + (1 if step > 0 else -1)
    return list(range(min_val, end, step))

def log_result(entry: dict, path: Path = LOG_PATH):
    path.parent.mkdir(parents=True, exist_ok=True)
    entry = {"ts": datetime.utcnow().isoformat() + "Z", **entry}
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry) + "\n")

# Console interface
def console_interface():
    print("Random Number Bot (console)")
    while True:
        print("\nOptions:")
        print("1) Single random (default 1-100)")
        print("2) Multiple randoms")
        print("3) Ranged sequence")
        print("4) Start GUI")
        print("5) Start HTTP API server (in background)")
        print("6) Exit")
        choice = input("Choose an option: ").strip()

        try:
            if choice == "1":
                mn = int(input("Min (default 1): ").strip() or 1)
                mx = int(input("Max (default 100): ").strip() or 100)
                val = single_random(mn, mx)
                print("Single random:", val)
                log_result({"mode": "single", "min": mn, "max": mx, "result": val})
            elif choice == "2":
                c = int(input("Count: ").strip())
                mn = int(input("Min (default 1): ").strip() or 1)
                mx = int(input("Max (default 100): ").strip() or 100)
                uniq = input("Unique? (y/N): ").strip().lower() == "y"
                nums = multiple_random(c, mn, mx, unique=uniq)
                print("Randoms:", nums)
                log_result({"mode": "multiple", "count": c, "min": mn, "max": mx, "unique": uniq, "result": nums})
            elif choice == "3":
                mn = int(input("Min: ").strip())
                mx = int(input("Max: ").strip())
                step = int(input("Step (default 1): ").strip() or 1)
                seq = ranged_sequence(mn, mx, step)
                print("Sequence:", seq)
                log_result({"mode": "range", "min": mn, "max": mx, "step": step, "result": seq})
            elif choice == "4":
                threading.Thread(target=start_gui, daemon=True).start()
                print("GUI started in background.")
            elif choice == "5":
                threading.Thread(target=start_api, daemon=True).start()
                print("API server starting in background (default http://127.0.0.1:8000).")
            elif choice == "6":
                print("Goodbye.")
                break
            else:
                print("Invalid choice.")
        except Exception as e:
            print("Error:", e)

