# random_bot.py
import random

def single_random(min_val=1, max_val=100):
    return random.randint(min_val, max_val)

def multiple_random(count, min_val=1, max_val=100, unique=False):
    if unique:
        if count > (max_val - min_val + 1):
            raise ValueError("Count larger than unique values available in range.")
        return random.sample(range(min_val, max_val+1), count)
    return [random.randint(min_val, max_val) for _ in range(count)]

def main():
    print("Random Number Bot")
    while True:
        print("\nOptions:")
        print("1) Single random (default 1-100)")
        print("2) Multiple randoms")
        print("3) Ranged randoms (generate numbers with step)")
        print("4) Exit")
        choice = input("Choose an option: ").strip()

        if choice == "1":
            print("Single random:", single_random())
        elif choice == "2":
            try:
                c = int(input("Count: ").strip())
                mn = int(input("Min (default 1): ").strip() or 1)
                mx = int(input("Max (default 100): ").strip() or 100)
                uniq = input("Unique? (y/N): ").strip().lower() == "y"
                nums = multiple_random(c, mn, mx, unique=uniq)
                print("Randoms:", nums)
            except Exception as e:
                print("Error:", e)
        elif choice == "3":
            try:
                mn = int(input("Min: ").strip())
                mx = int(input("Max: ").strip())
                step = int(input("Step (default 1): ").strip() or 1)
                if step == 0:
                    raise ValueError("Step cannot be 0.")
                nums = list(range(mn, mx+ (1 if step>0 else -1), step))
                print("Generated sequence:", nums)
            except Exception as e:
                print("Error:", e)
        elif choice == "4":
            print("Goodbye.")
            break
        else:
            print("Invalid choice.")

if __name__ == "__main__":
    main()


